# =============================================================================
# TalkBot Environment Variables
# Copy this file to .env and fill in your values:  cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Discord Bot Configuration (REQUIRED)
# Create a bot at https://discord.com/developers/applications
# -----------------------------------------------------------------------------

# Bot token from the "Bot" tab of your Discord application
DISCORD_TOKEN=your_discord_bot_token_here

# Application (client) ID from the "General Information" tab
CLIENT_ID=your_discord_application_client_id

# Developer user IDs (comma-separated Discord snowflakes)
DEV_IDS=

# Support server ID
SUPPORT_SERVER_ID=

# -----------------------------------------------------------------------------
# Google Cloud TTS (optional)
# https://cloud.google.com/text-to-speech/docs/quickstart-client-libraries
# Requires a service account JSON key file
# -----------------------------------------------------------------------------

# Path to your Google Cloud service account credentials JSON file
GOOGLE_APPLICATION_CREDENTIALS=./config/google-auth.json
TTS_GOOGLE_ENABLED=false
TTS_GOOGLE_ENFORCE_LIMIT=false
TTS_GOOGLE_LIMIT=5000000

# -----------------------------------------------------------------------------
# Amazon Polly TTS (optional)
# https://docs.aws.amazon.com/polly/latest/dg/get-started-what-is.html
# Requires an IAM user with polly:SynthesizeSpeech permission
# -----------------------------------------------------------------------------

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS region for Polly (default: us-east-1)
AWS_REGION=us-east-1
TTS_AMAZON_ENABLED=true
TTS_AMAZON_ENFORCE_LIMIT=false
TTS_AMAZON_LIMIT=5000000

# -----------------------------------------------------------------------------
# Azure Cognitive Services TTS (optional)
# https://learn.microsoft.com/en-us/azure/ai-services/speech-service/
# Create a Speech resource in the Azure portal
# -----------------------------------------------------------------------------

AZURE_SUBSCRIPTION_KEY=
# Azure TTS endpoint — change region as needed (e.g., westus, westeurope)
AZURE_ENDPOINT=https://eastus.tts.speech.microsoft.com/
TTS_AZURE_ENABLED=false
TTS_AZURE_ENFORCE_LIMIT=false
TTS_AZURE_LIMIT=5000000

# -----------------------------------------------------------------------------
# IBM Watson TTS (optional)
# https://cloud.ibm.com/catalog/services/text-to-speech
# Create a Text to Speech service instance
# -----------------------------------------------------------------------------

WATSON_API_KEY=
WATSON_SERVICE_URL=
TTS_WATSON_ENABLED=false
TTS_WATSON_ENFORCE_LIMIT=false
TTS_WATSON_LIMIT=5000000

# -----------------------------------------------------------------------------
# Tencent Cloud TTS (optional)
# https://cloud.tencent.com/product/tts
# Create API credentials in the Tencent Cloud console
# -----------------------------------------------------------------------------

TENCENT_ACCESS_KEY_ID=
TENCENT_SECRET_ACCESS_KEY=
TTS_TENCENT_ENABLED=false
TTS_TENCENT_ENFORCE_LIMIT=true
TTS_TENCENT_LIMIT=1000000

# -----------------------------------------------------------------------------
# Alibaba Cloud TTS (optional)
# https://www.alibabacloud.com/product/intelligent-speech-interaction
# Create an application and get your app key and token
# -----------------------------------------------------------------------------

ALIBABA_APP_KEY=
ALIBABA_TOKEN=
ALIBABA_ENDPOINT=
TTS_ALIBABA_ENABLED=false
TTS_ALIBABA_ENFORCE_LIMIT=true
TTS_ALIBABA_LIMIT=1000000

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------

# Environment: development or production
NODE_ENV=development

# Log level: error, warn, info, debug
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Bot Behaviour
# These were previously in config/config.json — now managed via .env
# -----------------------------------------------------------------------------

# Prefix character for text commands (default: !)
COMMAND_CHAR=!

# Tagline shown in bot presence / help
TAGLINE=

# Twitch streamer name used in example messages
ADVERTISE_STREAMER=

# Pester threshold (characters) before warning (default: 10000000)
PESTER_THRESHOLD=10000000

# Max queued audio items for Twitch integration (default: 10)
TWITCH_AUDIO_QUEUE_LIMIT=10

# Enable console logging for standard output and errors (true/false)
LOG_ERRORS=true
LOG_OUTPUT=true

# Inactivity timeout in ms before the bot leaves voice (default: 3600000 = 1 hour)
NEGLECT_TIMEOUT=3600000

# Comma-separated messages spoken on inactivity timeout
NEGLECT_TIMEOUT_MESSAGES=Talkbot inactivity timeout

# Default title used when addressing the bound user (default: master)
DEFAULT_TITLE=master
